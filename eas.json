{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6775406070",
        "bundleIdentifier": "com.mistergooddeal.glucoscan"
      }
    }
  },
  "experimental": {
    "ios": {
      "appExtensions": [
        {
          "targetName": "GlucoScanWidgets",
          "bundleIdentifier": "com.mistergooddeal.glucoscan.GlucoScanWidgets",
          "entitlements": {
            "com.apple.security.application-groups": [
              "group.com.mistergooddeal.glucoscan"
            ]
          }
        }
      ]
    }
  }
}
