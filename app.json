{
  "expo": {
    "name": "GlucoScan",
    "slug": "gluco-scan",
    "version": "2.4.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glucoscan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.mistergooddeal.glucoscan",
      "buildNumber": "19",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mistergooddeal.glucoscan"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "GlucoScan a besoin de la caméra pour scanner les codes-barres alimentaires.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mistergooddeal.glucoscan",
      "permissions": [
        "CAMERA"
      ],
      "versionCode": 19
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/fa-solid-900.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F1A",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GlucoScan a besoin de la caméra pour scanner les codes-barres alimentaires.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GlucoScan accède à vos photos pour ajouter une image à vos produits.",
          "cameraPermission": "GlucoScan a besoin de la caméra pour photographier vos produits.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-widget-extension",
        {
          "widgetsFolder": "ios/CarbWidgetExtension",
          "groupIdentifier": "group.com.mistergooddeal.glucoscan",
          "deploymentTarget": "16.2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5d21df7-8303-48fc-b0ca-c65c8503512f",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "GlucoScanWidgets",
                  "bundleIdentifier": "com.mistergooddeal.glucoscan.GlucoScanWidgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.mistergooddeal.glucoscan"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
